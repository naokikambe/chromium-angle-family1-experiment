diff --git a/src/libANGLE/renderer/metal/DisplayMtlFamily1Test.mm b/src/libANGLE/renderer/metal/DisplayMtlFamily1Test.mm
new file mode 100644
index 0000000..b9dbc4a
--- /dev/null
+++ b/src/libANGLE/renderer/metal/DisplayMtlFamily1Test.mm
@@ -0,0 +1,115 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <gtest/gtest.h>
+
+#include "EGL/egl.h"
+#include "EGL/eglext.h"
+#include "EGL/eglext_angle.h"
+#include "libANGLE/Display.h"
+#include "libANGLE/renderer/metal/DisplayMtl.h"
+
+namespace rx
+{
+namespace
+{
+class Family1ProfileScope final
+{
+  public:
+    Family1ProfileScope() { DisplayMtl::enableFamily1TestProfile(); }
+    ~Family1ProfileScope() { DisplayMtl::clearFamily1TestProfile(); }
+};
+
+EGLDisplay CreateMetalDisplay(bool disableFamily2Requirement, DisplayMtl::Family1TestStage stage)
+{
+    DisplayMtl::setFamily1TestForcedStopStage(stage);
+    const char *disabledFeatures[] = {"requireGpuFamily2", nullptr};
+    EGLAttrib attributes[]         = {
+        EGL_PLATFORM_ANGLE_TYPE_ANGLE,
+        EGL_PLATFORM_ANGLE_TYPE_METAL_ANGLE,
+        EGL_FEATURE_OVERRIDES_DISABLED_ANGLE,
+        reinterpret_cast<EGLAttrib>(disableFamily2Requirement ? disabledFeatures : nullptr),
+        EGL_NONE,
+    };
+
+    EGLDisplay display = eglGetPlatformDisplay(EGL_PLATFORM_ANGLE_ANGLE,
+                                                EGL_DEFAULT_DISPLAY, attributes);
+    if (display == EGL_NO_DISPLAY)
+    {
+        return EGL_NO_DISPLAY;
+    }
+
+    return display;
+}
+
+void ExpectForcedStop(bool disableFamily2Requirement, DisplayMtl::Family1TestStage stage)
+{
+    Family1ProfileScope profile;
+    EGLDisplay display = CreateMetalDisplay(disableFamily2Requirement, stage);
+    ASSERT_NE(display, EGL_NO_DISPLAY);
+    EXPECT_EQ(eglInitialize(display, nullptr, nullptr), EGL_FALSE);
+    EXPECT_EQ(eglGetError(), EGL_NOT_INITIALIZED);
+    EXPECT_EQ(DisplayMtl::getFamily1TestStage(), stage);
+    eglTerminate(display);
+}
+}  // namespace
+
+TEST(DisplayMtlFamily1Test, DeviceStage)
+{
+    ExpectForcedStop(false, DisplayMtl::Family1TestStage::Device);
+}
+
+TEST(DisplayMtlFamily1Test, FeatureGateStage)
+{
+    ExpectForcedStop(false, DisplayMtl::Family1TestStage::FeatureGate);
+}
+
+TEST(DisplayMtlFamily1Test, LaterInitializationStages)
+{
+    constexpr DisplayMtl::Family1TestStage kStages[] = {
+        DisplayMtl::Family1TestStage::CommandQueue,
+        DisplayMtl::Family1TestStage::FormatTable,
+        DisplayMtl::Family1TestStage::ShaderLibrary,
+        DisplayMtl::Family1TestStage::RenderUtils,
+    };
+
+    for (DisplayMtl::Family1TestStage stage : kStages)
+    {
+        ExpectForcedStop(true, stage);
+    }
+}
+
+TEST(DisplayMtlFamily1Test, SuccessCapabilities)
+{
+    Family1ProfileScope profile;
+    EGLDisplay display = CreateMetalDisplay(true, DisplayMtl::Family1TestStage::None);
+    ASSERT_NE(display, EGL_NO_DISPLAY);
+    ASSERT_EQ(eglInitialize(display, nullptr, nullptr), EGL_TRUE);
+    EXPECT_EQ(DisplayMtl::getFamily1TestStage(), DisplayMtl::Family1TestStage::Success);
+
+    auto *impl = static_cast<egl::Display *>(display)->getImplementation();
+    auto *mtl  = static_cast<DisplayMtl *>(impl);
+    const egl::DisplayExtensions &extensions = static_cast<egl::Display *>(display)->getExtensions();
+    EXPECT_EQ(mtl->getMaxSupportedESVersion(), gl::Version(3, 0));
+    EXPECT_EQ(mtl->getNativeCaps().maxDrawBuffers, 8);
+    EXPECT_EQ(mtl->getNativeCaps().maxColorAttachments, 8);
+    EXPECT_TRUE(extensions.createContextRobustness);
+    EXPECT_TRUE(extensions.iosurfaceClientBuffer);
+    EXPECT_TRUE(extensions.surfacelessContext);
+    EXPECT_TRUE(extensions.noConfigContext);
+    EXPECT_TRUE(extensions.displayTextureShareGroup);
+    EXPECT_TRUE(extensions.displaySemaphoreShareGroup);
+    EXPECT_TRUE(extensions.mtlTextureClientBuffer);
+    EXPECT_TRUE(extensions.waitUntilWorkScheduled);
+    EXPECT_TRUE(extensions.fenceSync);
+    EXPECT_TRUE(extensions.waitSync);
+    EXPECT_TRUE(extensions.robustResourceInitializationANGLE);
+    EXPECT_TRUE(extensions.image);
+    EXPECT_TRUE(extensions.imageBase);
+    EXPECT_TRUE(extensions.metalCreateContextOwnershipIdentityANGLE);
+    EXPECT_TRUE(extensions.mtlSyncSharedEventANGLE);
+    EXPECT_TRUE(extensions.mtlSyncCommandsScheduledANGLE);
+    eglTerminate(display);
+}
+}  // namespace rx
