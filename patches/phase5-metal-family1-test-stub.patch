+#endif  // LIBANGLE_RENDERER_METAL_DISPLAYMTLFAMILY1TESTBRIDGE_H_
diff --git a/src/libANGLE/renderer/metal/DisplayMtlFamily1TestBridge.mm b/src/libANGLE/renderer/metal/DisplayMtlFamily1TestBridge.mm
new file mode 100644
index 0000000..7f365fe
--- /dev/null
+++ b/src/libANGLE/renderer/metal/DisplayMtlFamily1TestBridge.mm
@@ -0,0 +1,72 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "libANGLE/renderer/metal/DisplayMtlFamily1TestBridge.h"
+
+#if defined(ANGLE_ENABLE_METAL_FAMILY1_TEST_STUB)
+#    include "libANGLE/Display.h"
+#    include "libANGLE/renderer/metal/DisplayMtl.h"
+
+extern "C" {
+
+ANGLE_METAL_FAMILY1_TEST_EXPORT void ANGLE_MetalFamily1TestEnableProfile()
+{
+    rx::DisplayMtl::enableFamily1TestProfile();
+}
+
+ANGLE_METAL_FAMILY1_TEST_EXPORT void ANGLE_MetalFamily1TestClearProfile()
+{
+    rx::DisplayMtl::clearFamily1TestProfile();
+}
+
+ANGLE_METAL_FAMILY1_TEST_EXPORT void ANGLE_MetalFamily1TestSetForcedStopStage(ANGLE_MetalFamily1TestStage stage)
+{
+    rx::DisplayMtl::setFamily1TestForcedStopStage(
+        static_cast<rx::DisplayMtl::Family1TestStage>(stage));
+}
+
+ANGLE_METAL_FAMILY1_TEST_EXPORT ANGLE_MetalFamily1TestStage ANGLE_MetalFamily1TestGetStage()
+{
+    return static_cast<ANGLE_MetalFamily1TestStage>(rx::DisplayMtl::getFamily1TestStage());
+}
+
+ANGLE_METAL_FAMILY1_TEST_EXPORT ANGLE_MetalFamily1TestSnapshot ANGLE_MetalFamily1TestGetSnapshot()
+{
+    ANGLE_MetalFamily1TestSnapshot snapshot = {};
+    snapshot.stage = static_cast<int>(rx::DisplayMtl::getFamily1TestStage());
+    rx::DisplayMtl *metalDisplay = rx::DisplayMtl::getFamily1TestDisplay();
+    if (metalDisplay == nullptr)
+    {
+        return snapshot;
+    }
+
+    gl::Version maxVersion = metalDisplay->getMaxSupportedESVersion();
+    snapshot.maxESMajor = maxVersion.getMajor();
+    snapshot.maxESMinor = maxVersion.getMinor();
+    const gl::Caps &caps = metalDisplay->getNativeCaps();
+    snapshot.maxDrawBuffers = caps.maxDrawBuffers;
+    snapshot.maxColorAttachments = caps.maxColorAttachments;
+
+    const egl::DisplayExtensions &extensions = metalDisplay->getDisplay()->getExtensions();
+    snapshot.createContextRobustness = extensions.createContextRobustness;
+    snapshot.iosurfaceClientBuffer = extensions.iosurfaceClientBuffer;
+    snapshot.surfacelessContext = extensions.surfacelessContext;
+    snapshot.noConfigContext = extensions.noConfigContext;
+    snapshot.displayTextureShareGroup = extensions.displayTextureShareGroup;
+    snapshot.displaySemaphoreShareGroup = extensions.displaySemaphoreShareGroup;
+    snapshot.mtlTextureClientBuffer = extensions.mtlTextureClientBuffer;
+    snapshot.waitUntilWorkScheduled = extensions.waitUntilWorkScheduled;
+    snapshot.fenceSync = extensions.fenceSync;
+    snapshot.waitSync = extensions.waitSync;
+    snapshot.robustResourceInitializationANGLE = extensions.robustResourceInitializationANGLE;
+    snapshot.image = extensions.image;
+    snapshot.imageBase = extensions.imageBase;
+    snapshot.metalCreateContextOwnershipIdentityANGLE =
+        extensions.metalCreateContextOwnershipIdentityANGLE;
+    snapshot.mtlSyncSharedEventANGLE = extensions.mtlSyncSharedEventANGLE;
+    snapshot.mtlSyncCommandsScheduledANGLE = extensions.mtlSyncCommandsScheduledANGLE;
+    return snapshot;
+}
+}
+#endif
