@@ -44,0 +45,50 @@
+#if defined(ANGLE_ENABLE_METAL_FAMILY1_TEST_STUB)
+namespace
+{
+struct Family1TestState
+{
+    bool enabled = false;
+    DisplayMtl::Family1TestStage forcedStage = DisplayMtl::Family1TestStage::None;
+    DisplayMtl::Family1TestStage observedStage = DisplayMtl::Family1TestStage::None;
+};
+
+thread_local Family1TestState gFamily1TestState;
+
+void RecordFamily1TestStage(DisplayMtl::Family1TestStage stage)
+{
+    if (gFamily1TestState.observedStage == DisplayMtl::Family1TestStage::None)
+    {
+        gFamily1TestState.observedStage = stage;
+    }
+}
+
+bool ShouldStopAtFamily1TestStage(DisplayMtl::Family1TestStage stage)
+{
+    return gFamily1TestState.enabled && gFamily1TestState.forcedStage == stage;
+}
+}  // namespace
+
+void DisplayMtl::enableFamily1TestProfile()
+{
+    gFamily1TestState.enabled       = true;
+    gFamily1TestState.forcedStage  = Family1TestStage::None;
+    gFamily1TestState.observedStage = Family1TestStage::None;
+}
+
+void DisplayMtl::clearFamily1TestProfile()
+{
+    gFamily1TestState = Family1TestState();
+}
+
+void DisplayMtl::setFamily1TestForcedStopStage(Family1TestStage stage)
+{
+    gFamily1TestState.forcedStage  = stage;
+    gFamily1TestState.observedStage = Family1TestStage::None;
+}
+
+DisplayMtl::Family1TestStage DisplayMtl::getFamily1TestStage()
+{
+    return gFamily1TestState.observedStage;
+}
+#endif
+
