diff --git a/src/libANGLE/renderer/metal/DisplayMtlFamily1Test.mm b/src/libANGLE/renderer/metal/DisplayMtlFamily1Test.mm
new file mode 100644
index 0000000..990662f
--- /dev/null
+++ b/src/libANGLE/renderer/metal/DisplayMtlFamily1Test.mm
@@ -0,0 +1,118 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <gtest/gtest.h>
+
+#ifdef EGL_EGL_PROTOTYPES
+#    undef EGL_EGL_PROTOTYPES
+#endif
+#define EGL_EGL_PROTOTYPES 1
+#include "EGL/egl.h"
+#include "EGL/eglext.h"
+#include "EGL/eglext_angle.h"
+#include "libANGLE/renderer/metal/DisplayMtlFamily1TestBridge.h"
+
+namespace
+{
+class Family1ProfileScope final
+{
+  public:
+    Family1ProfileScope() { ANGLE_MetalFamily1TestEnableProfile(); }
+    ~Family1ProfileScope() { ANGLE_MetalFamily1TestClearProfile(); }
+};
+
+EGLDisplay CreateMetalDisplay(bool disableFamily2Requirement, ANGLE_MetalFamily1TestStage stage)
+{
+    ANGLE_MetalFamily1TestSetForcedStopStage(stage);
+    const char *disabledFeatures[] = {"requireGpuFamily2", nullptr};
+    EGLAttrib attributes[] = {
+        EGL_PLATFORM_ANGLE_TYPE_ANGLE,
+        EGL_PLATFORM_ANGLE_TYPE_METAL_ANGLE,
+        EGL_NONE,
+        EGL_NONE,
+        EGL_NONE,
+    };
+    if (disableFamily2Requirement)
+    {
+        attributes[2] = EGL_FEATURE_OVERRIDES_DISABLED_ANGLE;
+        attributes[3] = reinterpret_cast<EGLAttrib>(disabledFeatures);
+    }
+
+    EGLDisplay display = eglGetPlatformDisplay(
+        EGL_PLATFORM_ANGLE_ANGLE, reinterpret_cast<void *>(EGL_DEFAULT_DISPLAY), attributes);
+    if (display == EGL_NO_DISPLAY)
+    {
+        return EGL_NO_DISPLAY;
+    }
+
+    return display;
+}
+
+void ExpectForcedStop(bool disableFamily2Requirement, ANGLE_MetalFamily1TestStage stage)
+{
+    Family1ProfileScope profile;
+    EGLDisplay display = CreateMetalDisplay(disableFamily2Requirement, stage);
+    ASSERT_NE(display, EGL_NO_DISPLAY);
+    EXPECT_EQ(eglInitialize(display, nullptr, nullptr), static_cast<EGLBoolean>(EGL_FALSE));
+    EXPECT_EQ(eglGetError(), EGL_NOT_INITIALIZED);
+    EXPECT_EQ(ANGLE_MetalFamily1TestGetStage(), stage);
+    eglTerminate(display);
+}
+}  // namespace
+
+TEST(DisplayMtlFamily1Test, DeviceStage)
+{
+    ExpectForcedStop(false, ANGLE_METAL_FAMILY1_TEST_STAGE_DEVICE);
+}
+
+TEST(DisplayMtlFamily1Test, FeatureGateStage)
+{
+    ExpectForcedStop(false, ANGLE_METAL_FAMILY1_TEST_STAGE_FEATURE_GATE);
+}
+
+TEST(DisplayMtlFamily1Test, LaterInitializationStages)
+{
+    constexpr ANGLE_MetalFamily1TestStage kStages[] = {
+        ANGLE_METAL_FAMILY1_TEST_STAGE_COMMAND_QUEUE,
+        ANGLE_METAL_FAMILY1_TEST_STAGE_FORMAT_TABLE,
+        ANGLE_METAL_FAMILY1_TEST_STAGE_SHADER_LIBRARY,
+        ANGLE_METAL_FAMILY1_TEST_STAGE_RENDER_UTILS,
+    };
+
+    for (ANGLE_MetalFamily1TestStage stage : kStages)
+    {
+        ExpectForcedStop(true, stage);
+    }
+}
+
+TEST(DisplayMtlFamily1Test, SuccessCapabilities)
+{
+    Family1ProfileScope profile;
+    EGLDisplay display = CreateMetalDisplay(true, ANGLE_METAL_FAMILY1_TEST_STAGE_NONE);
+    ASSERT_NE(display, EGL_NO_DISPLAY);
+    ASSERT_EQ(eglInitialize(display, nullptr, nullptr), static_cast<EGLBoolean>(EGL_TRUE));
+    ANGLE_MetalFamily1TestSnapshot snapshot = ANGLE_MetalFamily1TestGetSnapshot();
+    EXPECT_EQ(snapshot.stage, ANGLE_METAL_FAMILY1_TEST_STAGE_SUCCESS);
+    EXPECT_EQ(snapshot.maxESMajor, 3);
+    EXPECT_EQ(snapshot.maxESMinor, 0);
+    EXPECT_EQ(snapshot.maxDrawBuffers, 8);
+    EXPECT_EQ(snapshot.maxColorAttachments, 8);
+    EXPECT_TRUE(snapshot.createContextRobustness);
+    EXPECT_TRUE(snapshot.iosurfaceClientBuffer);
+    EXPECT_TRUE(snapshot.surfacelessContext);
+    EXPECT_TRUE(snapshot.noConfigContext);
+    EXPECT_TRUE(snapshot.displayTextureShareGroup);
+    EXPECT_TRUE(snapshot.displaySemaphoreShareGroup);
+    EXPECT_TRUE(snapshot.mtlTextureClientBuffer);
+    EXPECT_TRUE(snapshot.waitUntilWorkScheduled);
+    EXPECT_TRUE(snapshot.fenceSync);
+    EXPECT_TRUE(snapshot.waitSync);
+    EXPECT_TRUE(snapshot.robustResourceInitializationANGLE);
+    EXPECT_TRUE(snapshot.image);
+    EXPECT_TRUE(snapshot.imageBase);
+    EXPECT_TRUE(snapshot.metalCreateContextOwnershipIdentityANGLE);
+    EXPECT_TRUE(snapshot.mtlSyncSharedEventANGLE);
+    EXPECT_TRUE(snapshot.mtlSyncCommandsScheduledANGLE);
+    eglTerminate(display);
+}
