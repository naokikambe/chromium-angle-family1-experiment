+#endif
+
+typedef enum ANGLE_MetalFamily1TestStage
+{
+    ANGLE_METAL_FAMILY1_TEST_STAGE_NONE = 0,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_DEVICE,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_FEATURE_GATE,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_COMMAND_QUEUE,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_FORMAT_TABLE,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_SHADER_LIBRARY,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_RENDER_UTILS,
+    ANGLE_METAL_FAMILY1_TEST_STAGE_SUCCESS,
+} ANGLE_MetalFamily1TestStage;
+
+typedef struct ANGLE_MetalFamily1TestSnapshot
+{
+    int stage;
+    int maxESMajor;
+    int maxESMinor;
+    int maxDrawBuffers;
+    int maxColorAttachments;
+    uint8_t createContextRobustness;
+    uint8_t iosurfaceClientBuffer;
+    uint8_t surfacelessContext;
+    uint8_t noConfigContext;
+    uint8_t displayTextureShareGroup;
+    uint8_t displaySemaphoreShareGroup;
+    uint8_t mtlTextureClientBuffer;
