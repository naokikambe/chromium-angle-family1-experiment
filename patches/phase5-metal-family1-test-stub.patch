+    uint8_t fenceSync;
+    uint8_t waitSync;
+    uint8_t robustResourceInitializationANGLE;
+    uint8_t image;
+    uint8_t imageBase;
+    uint8_t metalCreateContextOwnershipIdentityANGLE;
+    uint8_t mtlSyncSharedEventANGLE;
+    uint8_t mtlSyncCommandsScheduledANGLE;
+} ANGLE_MetalFamily1TestSnapshot;
+
+extern "C" {
+ANGLE_METAL_FAMILY1_TEST_EXPORT void ANGLE_MetalFamily1TestEnableProfile();
+ANGLE_METAL_FAMILY1_TEST_EXPORT void ANGLE_MetalFamily1TestClearProfile();
+ANGLE_METAL_FAMILY1_TEST_EXPORT void ANGLE_MetalFamily1TestSetForcedStopStage(ANGLE_MetalFamily1TestStage stage);
+ANGLE_METAL_FAMILY1_TEST_EXPORT ANGLE_MetalFamily1TestStage ANGLE_MetalFamily1TestGetStage();
+ANGLE_METAL_FAMILY1_TEST_EXPORT ANGLE_MetalFamily1TestSnapshot ANGLE_MetalFamily1TestGetSnapshot();
+}
