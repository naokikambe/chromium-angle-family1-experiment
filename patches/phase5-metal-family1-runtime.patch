+void Phase5LogEGL(const char *event)
+{
+    ::fprintf(stderr, "[ANGLE_PHASE5_EGL] %s\n", event);
+    ::fflush(stderr);
+}
+
+void Phase5LogEGLContextAttributes(const EGLint *attrib_list)
+{
+    if (!attrib_list)
+    {
+        Phase5LogEGL("eglCreateContext_attributes=null");
+        return;
+    }
+
+    Phase5LogEGL("eglCreateContext_attributes=begin");
+    constexpr int kMaxAttributePairs = 32;
+    for (int index = 0; index < kMaxAttributePairs; ++index)
+    {
+        const EGLint key = attrib_list[index * 2];
+        if (key == EGL_NONE)
+        {
+            Phase5LogEGL("eglCreateContext_attributes=end");
+            return;
+        }
+
+        const EGLint value = attrib_list[index * 2 + 1];
+        ::fprintf(stderr,
+                  "[ANGLE_PHASE5_EGL] eglCreateContext_attribute key=0x%04x value=%d\n",
+                  static_cast<unsigned int>(key), static_cast<int>(value));
+        ::fflush(stderr);
+    }
+    Phase5LogEGL("eglCreateContext_attributes=truncated");
+}
+
