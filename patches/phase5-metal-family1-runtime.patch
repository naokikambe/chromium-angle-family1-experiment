+static bool UsePhase5VertexUnpackSnorm4x8(gl::ShaderType shaderType, id<MTLDevice> metalDevice)
+{
+#if TARGET_OS_OSX && !TARGET_OS_MACCATALYST
+    if (shaderType != gl::ShaderType::Vertex ||
+        angle::GetEnvironmentVar("ANGLE_PHASE5_ENABLE_METAL_FAMILY1") != "1")
+    {
+        return false;
+    }
+#    pragma clang diagnostic push
+#    pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    const bool supportsMacFamily1 = [metalDevice supportsFamily:MTLGPUFamilyMac1];
+#    pragma clang diagnostic pop
+    const bool supportsMacFamily2 = [metalDevice supportsFamily:MTLGPUFamilyMac2];
+    return supportsMacFamily1 && !supportsMacFamily2;
+#else
+    (void)shaderType;
+    (void)metalDevice;
+    return false;
+#endif
+}
