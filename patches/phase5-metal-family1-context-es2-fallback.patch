+                  requestedVersion.getMajor(), requestedVersion.getMinor(),
+                  maxSupportedVersion.getMajor(), maxSupportedVersion.getMinor());
+        ::fflush(stderr);
+        return maxSupportedVersion;
+    }
+#endif
+
     // We should return the requested version if the context is configured to disable backward
